# SAHAYIKA Backend Environment Configuration
PROJECT_NAME="SAHAYIKA - ASHA Digital Companion API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Network, Server Binding & Public Origin
HOST="0.0.0.0"
PORT=8008
# Leave PUBLIC_BASE_URL empty in local development to return relative media paths (/api/v1/ai/audio/...).
# Set to your public domain in staging/production (e.g. "https://api.sahayika.gov.in" or "https://my-backend.ngrok-free.app").
PUBLIC_BASE_URL=""

# Demo Mode (True = Uses rich seeded realistic Indian demo data without requiring external cloud accounts)
DEMO_MODE=True

# Firebase Configuration (Leave blank or set path to serviceAccountKey.json when connecting real Firebase)
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=""

# Gnani AI API Integration
GNANI_API_KEY=your-gnani-api-key-here
GNANI_API_ENDPOINT="https://api.vachana.ai"
GNANI_PRISMA_ENDPOINT="https://api.vachana.ai/stt/v3"
GNANI_EVON_ENDPOINT="https://api.vachana.ai/v1/evon/nlu"
GNANI_TIMBRE_ENDPOINT="https://api.vachana.ai/api/v1/tts/inference"

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL="gemini-1.5-flash"

# CORS Configuration (List of allowed web origins; in dev, local LAN IPs and localhost are auto-allowed)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://app.sahayika.gov.in"]
