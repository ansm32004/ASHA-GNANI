rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /audio_records/{allPaths=**} {
      // Audio records from visits accessible only by authenticated ASHA workers
      allow read: if request.auth != null && (request.auth.token.role == 'ASHA' || request.auth.token.role == 'SUPERVISOR');
      allow write: if request.auth != null && request.auth.token.role == 'ASHA'
                   && request.resource.size < 15 * 1024 * 1024 // Max 15MB audio
                   && request.resource.contentType.matches('audio/.*');
    }
  }
}

