# ==============================================================================
# SAHAYIKA Frontend Local Security & Environment Ignore Rules
# ==============================================================================

# Node dependencies & Expo build artifacts
node_modules/
.expo/
dist/
web-build/
*.apk
*.aab
*.ipa

# Local environment files
.env
.env.*
.env*.local
*.env
*.env.*

# Explicitly whitelist example / template files
!**/.env.example
!**/.env.template

# Mobile credentials, keystores and Google services
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS & Editor files
.DS_Store
Thumbs.db
