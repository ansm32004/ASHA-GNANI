# ==========================================
# SAHAYIKA Frontend Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Environment Mode
# ------------------------------------------
# Options: development | staging | production
EXPO_PUBLIC_ENV=development

# ------------------------------------------
# 2. Backend REST API Resolution
# ------------------------------------------
# NOTE: In local development, EXPO_PUBLIC_API_BASE_URL can be left UNSET or COMMENTED OUT.
# The centralized resolver dynamically auto-detects:
# - Physical Android/iOS phones on Expo Go -> auto-detects Metro LAN IP (e.g. http://192.168.x.x:8008/api/v1)
# - Android Emulator -> http://10.0.2.2:8008/api/v1
# - Web browser -> http://{hostname}:8008/api/v1
# - Production -> https://api.sahayika.gov.in/api/v1
#
# Set explicitly ONLY if you want to override the automatic resolution:
# EXPO_PUBLIC_API_BASE_URL=https://api.sahayika.gov.in/api/v1
# EXPO_PUBLIC_API_BASE_URL=https://staging-api.sahayika.gov.in/api/v1
# EXPO_PUBLIC_API_BASE_URL=https://my-tunnel.ngrok-free.app/api/v1

# Backend dev server port (Default: 8008)
EXPO_PUBLIC_BACKEND_PORT=8008

# API Request Timeout in Milliseconds (Default: 12000)
EXPO_PUBLIC_API_TIMEOUT_MS=12000

# ------------------------------------------
# 3. Authentication & Demo Mode
# ------------------------------------------
EXPO_PUBLIC_ENABLE_DEMO_LOGIN=true

# ------------------------------------------
# 4. Firebase Configuration (Optional Web Client)
# ------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
