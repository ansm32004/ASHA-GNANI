# ==========================================
# SAHAYIKA Frontend Environment Configuration
# Copy this file to `frontend/.env`
# ==========================================

# ------------------------------------------
# 1. Backend REST API
# ------------------------------------------
# For local web development:
EXPO_PUBLIC_API_URL=http://localhost:8008/api/v1

# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8008/api/v1

# For Physical Device Testing (Replace with your computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8008/api/v1

# For Production / Staging Cloud:
# EXPO_PUBLIC_API_URL=https://api.sahayika.gov.in/api/v1

# API Request Timeout in Milliseconds (Default: 10000)
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# ------------------------------------------
# 2. Authentication & Demo Mode
# ------------------------------------------
# Enable demo accounts without live backend auth (true for staging/dev, false for production)
EXPO_PUBLIC_ENABLE_DEMO_LOGIN=true

# ------------------------------------------
# 3. Firebase Configuration (Optional Web Client)
# ------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sahayika-asha-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sahayika-asha-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sahayika-asha-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

